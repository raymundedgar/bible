# Names only. Do not put real secrets in this file.
# Copy to .env for local Astro dev, or .dev.vars for the Cloudflare adapter.

BIBLE_API_BASE_URL=https://bible.helloao.org/api
BIBLE_TRANSLATION_ID=eng_webc

# Gemini free tier. Create a key at https://aistudio.google.com/apikey
# Leave billing unlinked if you want to stay on the free tier.
# Explanations stay off until AI_ENABLED=true and GEMINI_API_KEY is set.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
