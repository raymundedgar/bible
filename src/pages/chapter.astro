---
import Base from "../layouts/Base.astro";

export const prerender = true;
---

<Base
  title="Read a chapter — Free Bible Companion"
  description="Read the surrounding chapter in the World English Bible, Catholic edition."
>
  <main id="content" class="reading">
    <p class="kicker">Surrounding chapter</p>
    <h1 id="chapter-title">Loading chapter</h1>
    <p id="chapter-meta" class="chapter-meta"></p>
    <p id="chapter-error" class="form-error" role="alert" hidden></p>
    <article id="chapter-body" class="chapter-body"></article>
    <p><a href="/">Start over</a></p>
  </main>
</Base>

<script>
  import "../scripts/chapter.ts";
</script>
