---
import Base from "../layouts/Base.astro";

export const prerender = true;
---

<Base title="Offline — Free Bible Companion" description="A connection is needed to find passages.">
  <main id="content" class="reading">
    <p class="kicker">Offline</p>
    <h1>A connection is needed for a new recommendation</h1>
    <p>
      The pages of this app can open without a network, but finding a passage and loading chapter text uses the Scripture source online. Reconnect, then return home and try again.
    </p>
    <p><a class="button-link" href="/">Back home</a></p>
  </main>
</Base>
